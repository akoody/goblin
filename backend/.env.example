# Сервер
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
APP_URL=
CORS_ORIGINS=

# Обязательно, минимум 32 байта: openssl rand -hex 32.
# Без него сервер не стартует (кроме NODE_ENV=development/test).
JWT_SECRET=
PASSWORD_RESET_SECRET=

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Кастодиальные кошельки. Храните только в окружении сервера, никогда в репозитории.
MASTER_MNEMONIC=
WALLET_ENCRYPTION_KEY=

ADMIN_EMAILS=

# Внешние сервисы
TRONGRID_API_KEY=
TRON_FULL_HOST=
SOLANA_RPC_URL=
ETHEREUM_RPC_URL=
BITCOIN_API_URL=
JUPITER_API_KEY=
SAFIO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=

# Переключатели подписи транзакций и движков
TRON_SWAP_SIGNING_ENABLED=false
SOLANA_SWAP_SIGNING_ENABLED=false
NATIVE_CHAINS_ENABLED=false
TREASURY_COLLECTION_PAUSED=true
